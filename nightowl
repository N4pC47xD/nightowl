        dim("    None found in PATH")

    if IS_LINUX:
        # Writable directories in PATH — can be used for PATH hijacking
        print(f"\n  {C.BOLD}PATH hijacking check (writable dirs in $PATH):{C.RESET}")
        path_dirs = os.environ.get("PATH", "").split(":")
        for d in path_dirs:
            if d and os.path.isdir(d) and os.access(d, os.W_OK):
                warn(f"WRITABLE PATH dir: {d}")

        # Custom binaries in /opt, /usr/local, etc.
        print(f"\n  {C.BOLD}Binaries in non-standard locations:{C.RESET}")
        for search_dir in ["/opt", "/usr/local/bin", "/usr/local/sbin", "/home"]:
            if os.path.isdir(search_dir):
                result = run(f"find {search_dir} -type f -executable 2>/dev/null | head -30")
                if result:
                    for line in result.splitlines():
                        dim(f"    {line}")


# ═════════════════════════════════════════════
#  MODULE 6 — Scheduled Jobs / Cron
# ═════════════════════════════════════════════
def enum_jobs():
    section("SCHEDULED JOBS & CRON")

    if IS_LINUX:
        # System crontabs
        cron_locations = [
            "/etc/crontab",
            "/etc/cron.d",
            "/etc/cron.hourly",
            "/etc/cron.daily",
            "/etc/cron.weekly",
            "/etc/cron.monthly",
            "/var/spool/cron/crontabs",
        ]

        print(f"\n  {C.BOLD}System cron locations:{C.RESET}")
        for loc in cron_locations:
            p = Path(loc)
            if p.exists():
                if p.is_file():
                    content = run(f"cat {loc} 2>/dev/null")
                    if content and not content.startswith("#"):
                        hit("Cron file", loc)
                        for line in content.splitlines():
                            if line and not line.startswith("#"):
                                dim(f"      {line}")
                elif p.is_dir():
                    files = list(p.iterdir())
                    if files:
                        hit("Cron dir", f"{loc}  ({len(files)} entries)")
                        for f in files:
                            content = run(f"cat {f} 2>/dev/null")
                            for line in content.splitlines():
                                if line and not line.startswith("#"):
                                    dim(f"      [{f.name}] {line}")

        # User crontabs
        print(f"\n  {C.BOLD}User crontabs (/var/spool/cron):{C.RESET}")
        spool = Path("/var/spool/cron/crontabs")
        if spool.exists():
            for entry in spool.iterdir():
                content = run(f"cat {entry} 2>/dev/null")
                if content:
                    hit("User crontab", str(entry))
                    for line in content.splitlines():
                        if line and not line.startswith("#"):
                            dim(f"      {line}")
        else:
            dim("    /var/spool/cron/crontabs not accessible")

        # Current user's crontab
        user_cron = run("crontab -l 2>/dev/null")
        if user_cron and "no crontab" not in user_cron.lower():
            hit("Current user crontab", "")
            for line in user_cron.splitlines():
                if line and not line.startswith("#"):
                    dim(f"      {line}")

        # systemd timers
        print(f"\n  {C.BOLD}Systemd timers:{C.RESET}")
        timers = run("systemctl list-timers --all 2>/dev/null | head -30")
        if timers:
            for line in timers.splitlines():
                dim(f"    {line}")
        else:
            dim("    (systemctl not available or no timers)")

        # at jobs
        atq = run("atq 2>/dev/null")
        if atq:
            hit("at jobs queued", atq)

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Scheduled Tasks:{C.RESET}")
        tasks = run("schtasks /query /fo LIST /v 2>nul | findstr /C:\"Task Name\" /C:\"Status\" /C:\"Run As User\"")
        dim(tasks)


# ═════════════════════════════════════════════
#  MODULE 7 — Writable Files & Directories
# ═════════════════════════════════════════════
def enum_writable():
    section("WRITABLE FILES & DIRECTORIES")

    if IS_LINUX:
        SKIP_DIRS = {
            "/proc", "/sys", "/dev", "/run", "/tmp",
            "/var/tmp", "/var/lock", "/var/run",
        }

        # World-writable directories (excluding /tmp etc.)
        print(f"\n  {C.BOLD}World-writable directories (non-standard):{C.RESET}")
        ww_dirs = run("find / -maxdepth 5 -type d -perm -0002 2>/dev/null")
        for d in ww_dirs.splitlines():
            d = d.strip()
            if not any(d.startswith(skip) for skip in SKIP_DIRS) and d not in SKIP_DIRS:
                hit("World-writable dir", d)

        # Writable files in interesting locations
        print(f"\n  {C.BOLD}Writable files in sensitive locations:{C.RESET}")
        SENSITIVE_DIRS = ["/etc", "/usr/bin", "/usr/sbin", "/bin", "/sbin",
                          "/usr/local/bin", "/opt", "/var/www"]
        for d in SENSITIVE_DIRS:
            if os.path.isdir(d):
                result = run(f"find {d} -maxdepth 3 -writable -type f 2>/dev/null")
                for f in result.splitlines():
                    warn(f"WRITABLE: {f}")

        # Writable scripts referenced in cron / systemd
        print(f"\n  {C.BOLD}Writable scripts called by cron/systemd:{C.RESET}")
        cron_scripts = run(
            "grep -rh '^[^#]' /etc/crontab /etc/cron.d/* /var/spool/cron/crontabs/* 2>/dev/null"
            " | awk '{print $NF}' | grep '^/' | sort -u"
        )
        for script in cron_scripts.splitlines():
            script = script.strip()
            if script and os.path.isfile(script) and os.access(script, os.W_OK):
                warn(f"WRITABLE CRON SCRIPT: {script}")

        # /tmp contents
        print(f"\n  {C.BOLD}/tmp contents:{C.RESET}")
        tmp_contents = run("ls -la /tmp 2>/dev/null")
        if tmp_contents:
            for line in tmp_contents.splitlines():
                dim(f"    {line}")

        # NFS exports with no_root_squash
        print(f"\n  {C.BOLD}NFS exports (no_root_squash check):{C.RESET}")
        exports = run("cat /etc/exports 2>/dev/null")
        if exports:
            for line in exports.splitlines():
                if line and not line.startswith("#"):
                    if "no_root_squash" in line:
                        warn(f"NFS no_root_squash: {line}")
                    else:
                        dim(f"    {line}")

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Writable dirs in Program Files:{C.RESET}")
        dim(run("icacls \"C:\\Program Files\" /T 2>nul | findstr /C:\"Everyone\" /C:\"BUILTIN\\Users\""))


# ═════════════════════════════════════════════
#  MODULE 8 — Running Services & Localhost Ports
# ═════════════════════════════════════════════
def enum_services():
    section("LOCAL SERVICES & INTERNAL PORTS")

    if IS_LINUX:
        # Listening ports — localhost only (these are hidden from outside scans)
        print(f"\n  {C.BOLD}Ports ONLY listening on localhost (internal services):{C.RESET}")
        ss_out = run("ss -tlnp 2>/dev/null || netstat -tlnp 2>/dev/null")
        for line in ss_out.splitlines():
            if any(x in line for x in ["127.0.0.1", "::1", "localhost"]):
                hit("Internal port", line.strip())

        # All listening sockets
        print(f"\n  {C.BOLD}All listening TCP sockets:{C.RESET}")
        for line in ss_out.splitlines()[1:]:  # skip header
            dim(f"    {line}")

        # UDP sockets
        print(f"\n  {C.BOLD}Listening UDP sockets:{C.RESET}")
        udp = run("ss -ulnp 2>/dev/null || netstat -ulnp 2>/dev/null")
        for line in udp.splitlines()[1:]:
            dim(f"    {line}")

        # Running processes (non-root ones are interesting too)
        print(f"\n  {C.BOLD}Running processes (interesting):{C.RESET}")
        ps = run("ps auxww 2>/dev/null")
        IGNORE_PROCS = {"ps", "grep", "bash", "sh", "python", "python3", "sshd:", "["}
        for line in ps.splitlines():
            parts = line.split()
            if len(parts) > 10:
                user = parts[0]
                cmd  = " ".join(parts[10:])
                if any(cmd.startswith(ign) for ign in IGNORE_PROCS):
                    continue
                if user == "root":
                    print(f"    {C.RED}[root]{C.RESET} {cmd[:100]}")
                else:
                    dim(f"    [{user}] {cmd[:100]}")

        # systemd services
        print(f"\n  {C.BOLD}Active systemd services:{C.RESET}")
        sysd = run("systemctl list-units --type=service --state=running 2>/dev/null | head -30")
        if sysd:
            for line in sysd.splitlines():
                dim(f"    {line}")

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Listening ports:{C.RESET}")
        dim(run("netstat -ano | findstr LISTENING"))
        print(f"\n  {C.BOLD}Running services:{C.RESET}")
        dim(run("sc query state= all | findstr SERVICE_NAME"))


# ═════════════════════════════════════════════
#  MODULE 9 — Credentials & Sensitive Files
# ═════════════════════════════════════════════
def enum_credentials():
    section("CREDENTIALS & SENSITIVE FILES")

    if IS_LINUX:
        # Common credential file locations
        CRED_FILES = [
            # Config / app credentials
            "/var/www/html/config.php", "/var/www/html/wp-config.php",
            "/var/www/html/.env", "/var/www/.env",
            "/home/*/.env", "/root/.env",
            # DB
            "/etc/mysql/debian.cnf", "/root/.mysql_history",
            "/home/*/.mysql_history",
            # SSH
            "/home/*/.ssh/id_rsa", "/root/.ssh/id_rsa",
            "/home/*/.ssh/authorized_keys", "/root/.ssh/authorized_keys",
            # History files
            "/home/*/.bash_history", "/root/.bash_history",
            "/home/*/.zsh_history",
            # Cloud
            "/home/*/.aws/credentials", "/root/.aws/credentials",
            # Misc
            "/etc/passwd", "/etc/shadow", "/etc/group",
            "/etc/security/opasswd",
        ]

        print(f"\n  {C.BOLD}Checking sensitive file locations:{C.RESET}")
        for pattern in CRED_FILES:
            # Handle glob patterns manually
            if "*" in pattern:
                import glob
                matches = glob.glob(pattern)
            else:
                matches = [pattern] if os.path.exists(pattern) else []

            for fpath in matches:
                p = Path(fpath)
                if p.exists():
                    readable = os.access(fpath, os.R_OK)
                    size = p.stat().st_size
                    flag = f"{C.GREEN}[readable]{C.RESET}" if readable else f"{C.GREY}[no access]{C.RESET}"
                    hit(flag, f"{fpath}  ({size} bytes)")

                    # Peek into history files for passwords
                    if readable and "history" in fpath and size < 50000:
                        content = run(f"grep -i 'pass\\|secret\\|token\\|api\\|key\\|user\\|mysql\\|psql' {fpath} 2>/dev/null | head -10")
                        if content:
                            warn(f"  Interesting lines in {fpath}:")
                            for line in content.splitlines():
                                dim(f"      {line}")

        # /etc/shadow readable?
        if os.access("/etc/shadow", os.R_OK):
            warn("/etc/shadow IS READABLE — try cracking hashes!")
            shadow = run("cat /etc/shadow 2>/dev/null | grep -v ':\\*:\\|:!:'")
            if shadow:
                for line in shadow.splitlines():
                    print(f"    {C.RED}{line}{C.RESET}")

        # Config files with passwords in web roots
        print(f"\n  {C.BOLD}Searching for password strings in web/config files:{C.RESET}")
        grep_out = run(
            "grep -rn --include='*.php' --include='*.conf' --include='*.ini' "
            "--include='*.env' --include='*.cfg' --include='*.xml' "
            "-i 'password\\s*=\\|passwd\\s*=\\|db_pass\\|secret_key' "
            "/var/www /etc /opt 2>/dev/null | head -20"
        )
        if grep_out:
            for line in grep_out.splitlines():
                hit("Possible credential", line[:120])

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}SAM / credential files:{C.RESET}")
        for f in [r"C:\Windows\System32\config\SAM",
                  r"C:\Windows\repair\SAM",
                  r"C:\Windows\System32\config\SYSTEM"]:
            if os.path.exists(f):
                hit("Found", f)
        print(f"\n  {C.BOLD}Stored credentials:{C.RESET}")
        dim(run("cmdkey /list"))
        dim(run("reg query HKLM /f password /t REG_SZ /s 2>nul | head -40"))


