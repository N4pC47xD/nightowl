# ─────────────────────────────────────────────
#  ANSI Colors
# ─────────────────────────────────────────────
class C:
    RESET   = "\033[0m"
    BOLD    = "\033[1m"
    RED     = "\033[91m"
    GREEN   = "\033[92m"
    YELLOW  = "\033[93m"
    CYAN    = "\033[96m"
    MAGENTA = "\033[95m"
    GREY    = "\033[90m"
    WHITE   = "\033[97m"

VERSION = "1.0"
AUTHOR  = "N4pC47xD"

def banner():
    print(f"""
{C.WHITE}    ,___,
    {C.RED}[O.O]{C.WHITE}   {C.BOLD}{C.RED}N I G H T O W L{C.RESET}
{C.WHITE}    /)  (\\  {C.GREY}─────────────────────────────────{C.RESET}
{C.WHITE}  -"--  --"-  {C.GREY}Post-Exploitation Enumerator{C.RESET}
{C.GREY}               version {VERSION}  //  author {AUTHOR}{C.RESET}
{C.GREY}               authorized systems only{C.RESET}
""")

def section(title: str):
    width = 60
    print(f"\n{C.CYAN}{C.BOLD}{'═' * width}{C.RESET}")
    print(f"{C.CYAN}{C.BOLD}  {title}{C.RESET}")
    print(f"{C.CYAN}{'═' * width}{C.RESET}")

def hit(label: str, value: str):
    """Print a notable finding."""
    print(f"  {C.YELLOW}[+]{C.RESET} {C.BOLD}{label}:{C.RESET} {value}")

def info(label: str, value: str):
    """Print an informational item."""
    print(f"  {C.GREEN}[*]{C.RESET} {label}: {value}")

def warn(msg: str):
    print(f"  {C.RED}[!]{C.RESET} {C.RED}{msg}{C.RESET}")

def dim(msg: str):
    print(f"  {C.GREY}{msg}{C.RESET}")

def run(cmd: str, shell=True, timeout=10) -> str:
    """Run a shell command and return stdout; empty string on error."""
    try:
        result = subprocess.run(
            cmd, shell=shell, capture_output=True, text=True, timeout=timeout
        )
        return result.stdout.strip()
    except Exception:
        return ""


# ─────────────────────────────────────────────
#  OS Detection
# ─────────────────────────────────────────────
IS_LINUX   = sys.platform.startswith("linux")
IS_WINDOWS = sys.platform.startswith("win")
IS_MAC     = sys.platform == "darwin"


# ═════════════════════════════════════════════
#  MODULE 1 — System Info
# ═════════════════════════════════════════════
def enum_system():
    section("SYSTEM INFORMATION")

    info("Hostname",        socket.gethostname())
    info("OS",             platform.platform())
    info("Architecture",   platform.machine())
    info("Python",         sys.version.split()[0])

    if IS_LINUX:
        # Kernel version
        kernel = run("uname -r")
        info("Kernel", kernel)

        # Try to detect distro
        distro = run("cat /etc/os-release | grep PRETTY_NAME | cut -d= -f2")
        if distro:
            info("Distro", distro.strip('"'))

        # CPU info
        cpuinfo = run("grep 'model name' /proc/cpuinfo | head -1 | cut -d: -f2")
        if cpuinfo:
            info("CPU", cpuinfo.strip())

        # Uptime
        uptime = run("uptime -p")
        if uptime:
            info("Uptime", uptime)

        # Check if we're in a container / VM
        if os.path.exists("/.dockerenv"):
            warn("Running inside a DOCKER container")
        virt = run("systemd-detect-virt 2>/dev/null")
        if virt and virt != "none":
            hit("Virtualization", virt)

        # Interesting mounts
        mounts = run("mount | grep -v 'proc\\|sys\\|dev\\|run\\|cgroup'")
        if mounts:
            print(f"\n  {C.BOLD}Non-standard Mounts:{C.RESET}")
            for line in mounts.splitlines():
                dim(f"    {line}")

    elif IS_WINDOWS:
        info("Windows version", run("ver"))
        info("SystemInfo (brief)", run("systeminfo | findstr /C:\"OS Name\" /C:\"OS Version\" /C:\"System Type\""))


# ═════════════════════════════════════════════
#  MODULE 2 — User Enumeration
# ═════════════════════════════════════════════
def enum_users():
    section("USER ENUMERATION")

    # Current user
    current = run("whoami")
    uid = os.getuid() if IS_LINUX else "N/A"
    hit("Current user", f"{current}  (uid={uid})")

    if uid == 0:
        warn("Running as ROOT — full access")

    if IS_LINUX:
        # All users from /etc/passwd with login shells
        print(f"\n  {C.BOLD}Users with login shells:{C.RESET}")
        try:
            for pw in pwd.getpwall():
                shell = pw.pw_shell
                if shell and shell not in ("/bin/false", "/usr/sbin/nologin", "/sbin/nologin"):
                    tag = ""
                    if pw.pw_uid == 0:
                        tag = f" {C.RED}[ROOT]{C.RESET}"
                    elif pw.pw_uid < 1000:
                        tag = f" {C.GREY}[system]{C.RESET}"
                    else:
                        tag = f" {C.GREEN}[user]{C.RESET}"
                    print(f"    {pw.pw_name:<20} uid={pw.pw_uid:<6} shell={shell}{tag}")
        except Exception as e:
            warn(f"Could not read /etc/passwd: {e}")

        # Home directories
        print(f"\n  {C.BOLD}Home directories (readable):{C.RESET}")
        for home in Path("/home").iterdir() if Path("/home").exists() else []:
            try:
                readable = os.access(home, os.R_OK)
                flag = f"{C.GREEN}[readable]{C.RESET}" if readable else f"{C.GREY}[no access]{C.RESET}"
                print(f"    {home}  {flag}")
                if readable:
                    # Peek for interesting files
                    for fname in [".bash_history", ".ssh", ".aws", ".gnupg", ".profile", ".bashrc"]:
                        fpath = home / fname
                        if fpath.exists():
                            hit("  Interesting", str(fpath))
            except Exception:
                pass

        # Last logins
        last = run("last -n 10 2>/dev/null | head -15")
        if last:
            print(f"\n  {C.BOLD}Recent logins:{C.RESET}")
            for line in last.splitlines():
                dim(f"    {line}")

        # Currently logged in
        who = run("who 2>/dev/null || w 2>/dev/null | head -5")
        if who:
            print(f"\n  {C.BOLD}Currently logged in:{C.RESET}")
            for line in who.splitlines():
                dim(f"    {line}")

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Local Users:{C.RESET}")
        users = run("net user")
        dim(users)
        print(f"\n  {C.BOLD}Administrators:{C.RESET}")
        admins = run("net localgroup administrators")
        dim(admins)


# ═════════════════════════════════════════════
#  MODULE 3 — Group Enumeration
# ═════════════════════════════════════════════
def enum_groups():
    section("GROUP ENUMERATION")

    # Interesting groups that grant elevated access
    INTERESTING_GROUPS = {
        "sudo", "wheel", "adm", "admin", "root",
        "docker", "lxd", "lxc", "disk", "shadow",
        "video", "staff", "dba", "www-data", "ftp",
        "operator", "systemd-journal", "kmem", "tape",
        "plugdev", "bluetooth", "netdev",
    }

    if IS_LINUX:
        print(f"\n  {C.BOLD}Current user groups:{C.RESET}")
        try:
            current_groups = [grp.getgrgid(gid).gr_name for gid in os.getgroups()]
            for g in current_groups:
                tag = ""
                if g in INTERESTING_GROUPS:
                    tag = f"  {C.RED}<<< INTERESTING!{C.RESET}"
                print(f"    {g}{tag}")
        except Exception as e:
            dim(run("id"))

        # Map all groups → members, highlight interesting ones
        print(f"\n  {C.BOLD}All groups & members (non-empty):{C.RESET}")
        try:
            for gr in grp.getgrall():
                if gr.gr_mem:
                    tag = f"  {C.RED}[!]{C.RESET}" if gr.gr_name in INTERESTING_GROUPS else ""
                    print(f"    {gr.gr_name:<20} {', '.join(gr.gr_mem)}{tag}")
        except Exception as e:
            warn(f"Could not enumerate groups: {e}")

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Local Groups:{C.RESET}")
        dim(run("net localgroup"))


# ═════════════════════════════════════════════
#  MODULE 4 — Sudo / Privileges
# ═════════════════════════════════════════════
def enum_sudo():
    section("SUDO / PRIVILEGE ESCALATION PATHS")

    if IS_LINUX:
        # sudo -l
        print(f"\n  {C.BOLD}sudo -l output:{C.RESET}")
        sudo_out = run("sudo -l 2>/dev/null")
        if sudo_out:
            for line in sudo_out.splitlines():
                if any(x in line for x in ["ALL", "NOPASSWD", "(root)"]):
                    hit("SUDO RULE", line.strip())
                else:
                    dim(f"    {line}")
        else:
            dim("    (no sudo access or password required)")

        # SUID binaries
        print(f"\n  {C.BOLD}SUID binaries:{C.RESET}")
        suid_bins = run("find / -perm -4000 -type f 2>/dev/null")
        # Common baseline — these are expected
        COMMON_SUID = {
            "/usr/bin/sudo", "/usr/bin/passwd", "/usr/bin/chsh",
            "/usr/bin/chfn", "/usr/bin/newgrp", "/usr/bin/gpasswd",
            "/bin/su", "/bin/mount", "/bin/umount", "/usr/bin/su",
            "/usr/lib/openssh/ssh-keysign", "/usr/bin/pkexec",
        }
        for line in suid_bins.splitlines():
            line = line.strip()
            if line not in COMMON_SUID:
                hit("Non-standard SUID", line)
            else:
                dim(f"    {line}  (standard)")

        # SGID binaries
        print(f"\n  {C.BOLD}SGID binaries (non-standard):{C.RESET}")
        sgid_bins = run("find / -perm -2000 -type f 2>/dev/null")
        COMMON_SGID = {"/usr/bin/wall", "/usr/bin/write", "/usr/bin/ssh-agent",
                       "/sbin/unix_chkpwd", "/usr/bin/crontab", "/usr/bin/dotlockfile"}
        for line in sgid_bins.splitlines():
            if line.strip() not in COMMON_SGID:
                hit("Non-standard SGID", line.strip())

        # Capabilities
        print(f"\n  {C.BOLD}File capabilities:{C.RESET}")
        caps = run("getcap -r / 2>/dev/null")
        if caps:
            for line in caps.splitlines():
                hit("Capability", line.strip())
        else:
            dim("    (none found or getcap not available)")

        # Writable /etc/passwd or /etc/shadow
        for sensitive in ["/etc/passwd", "/etc/shadow", "/etc/sudoers"]:
            if os.path.exists(sensitive) and os.access(sensitive, os.W_OK):
                warn(f"WRITABLE SENSITIVE FILE: {sensitive}")

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Privileges for current user:{C.RESET}")
        dim(run("whoami /priv"))
        print(f"\n  {C.BOLD}Token groups:{C.RESET}")
        dim(run("whoami /groups"))


# ═════════════════════════════════════════════
#  MODULE 5 — Non-standard Binaries
# ═════════════════════════════════════════════
def enum_interesting_binaries():
    section("INTERESTING / NON-STANDARD BINARIES")

    # GTFOBins-style list — these are interesting if found
    INTERESTING = [
        # Networking/exfil
        "nc", "ncat", "netcat", "curl", "wget", "fetch", "tftp", "ftp",
        "scp", "rsync", "socat", "nmap", "masscan",
        # Scripting / shells
        "python", "python2", "python3", "python3.x", "perl", "ruby",
        "lua", "php", "node", "nodejs", "tclsh", "expect",
        "bash", "dash", "zsh", "ksh", "fish",
        # Compilers
        "gcc", "cc", "g++", "make", "cmake", "go", "rustc",
        # Editors (can spawn shells)
        "vim", "vi", "nano", "emacs", "ed", "awk", "gawk", "mawk",
        # File access / archive
        "tar", "zip", "unzip", "7z", "gzip", "bzip2",
        "dd", "cp", "mv", "cat", "tee", "less", "more",
        # DB clients
        "mysql", "psql", "sqlite3", "mongo",
        # Misc powerful
        "docker", "kubectl", "lxc", "lxd",
        "strace", "ltrace", "gdb", "pwndbg",
        "openssl", "base64", "xxd",
    ]

    print(f"\n  {C.BOLD}Checking for interesting binaries in PATH:{C.RESET}")
    found = []
    for binary in INTERESTING:
        path = which(binary)
        if path:
