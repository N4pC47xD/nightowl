#  MODULE 13 — Container Discovery & Pivoting
# ═════════════════════════════════════════════
def enum_container():
    section("CONTAINER DISCOVERY & PIVOT TARGETS")

    if IS_LINUX:

        # ── Where are we? (context only, not the goal) ──────────────
        print(f"\n  {C.BOLD}Current environment:{C.RESET}")
        in_docker = os.path.exists("/.dockerenv")
        cgroup    = run("cat /proc/1/cgroup 2>/dev/null")
        in_lxc    = "lxc" in cgroup

        if in_docker:
            info("Environment", "Inside a Docker container")
        elif in_lxc:
            info("Environment", "Inside an LXC container")
        else:
            info("Environment", "Appears to be a bare host or VM")

        cap_bnd = run("grep CapBnd /proc/self/status 2>/dev/null | awk '{print $2}'")
        if cap_bnd:
            if "ffffffffffffffff" in cap_bnd:
                warn("Full capabilities (CapBnd=fff...) — privileged container!")
            else:
                info("CapBnd", cap_bnd)

        # ── Docker socket — control plane access ────────────────────
        print(f"\n  {C.BOLD}Docker socket:{C.RESET}")
        for sock in ["/var/run/docker.sock", "/run/docker.sock"]:
            if os.path.exists(sock):
                if os.access(sock, os.R_OK | os.W_OK):
                    warn(f"Docker socket READABLE/WRITABLE: {sock}")
                    warn("Can enumerate and escape to host via 'docker run -v /:/mnt'")

                    # List all running containers on this host
                    print(f"\n  {C.BOLD}Containers running on this host (via docker ps):{C.RESET}")
                    docker_ps = run("docker ps --format 'table {{.ID}}\\t{{.Image}}\\t{{.Names}}\\t{{.Ports}}\\t{{.Status}}' 2>/dev/null")
                    if docker_ps:
                        for line in docker_ps.splitlines():
                            hit("Container", line)
                    else:
                        dim("    (docker binary not in PATH — try curl --unix-socket)")

                    # Docker API via curl if docker binary missing
                    print(f"\n  {C.BOLD}Containers via Docker API (curl fallback):{C.RESET}")
                    api_out = run(f"curl -s --unix-socket {sock} http://localhost/containers/json 2>/dev/null | python3 -m json.tool 2>/dev/null | grep -E 'Id|Image|Name|Status|Ports' | head -40")
                    if api_out:
                        for line in api_out.splitlines():
                            dim(f"    {line}")

                    # List all images — may reveal what apps are deployed
                    print(f"\n  {C.BOLD}Docker images on host:{C.RESET}")
                    images = run("docker images --format '{{.Repository}}:{{.Tag}}\\t{{.Size}}' 2>/dev/null")
                    if images:
                        for line in images.splitlines():
                            info("Image", line)

                    # Docker networks — reveals internal subnets
                    print(f"\n  {C.BOLD}Docker networks (internal subnets):{C.RESET}")
                    nets = run("docker network ls 2>/dev/null")
                    if nets:
                        for line in nets.splitlines():
                            dim(f"    {line}")
                    net_detail = run("docker network inspect bridge 2>/dev/null | grep -E 'Subnet|Gateway|IPv4Address' | head -20")
                    if net_detail:
                        for line in net_detail.splitlines():
                            hit("Network detail", line.strip())

        # ── LXD / LXC group — instant root escape ───────────────────
        print(f"\n  {C.BOLD}LXD/LXC group membership:{C.RESET}")
        try:
            current_groups = [grp.getgrgid(gid).gr_name for gid in os.getgroups()]
            if "lxd" in current_groups:
                warn("In lxd group — escape: lxc init ubuntu:18.04 privesc -c security.privileged=true")
            elif "lxc" in current_groups:
                warn("In lxc group — container escape may be possible")
            else:
                dim("    Not in lxd/lxc group")
        except Exception:
            pass

        # ── Other containers visible via /proc ──────────────────────
        print(f"\n  {C.BOLD}Other container processes visible in /proc:{C.RESET}")
        # If we can see other namespaces, sibling containers may be visible
        ns_out = run("ls -la /proc/*/ns/net 2>/dev/null | awk '{print $NF}' | sort -u | head -20")
        namespaces = set()
        for line in ns_out.splitlines():
            if "net:[" in line:
                namespaces.add(line.strip())
        if len(namespaces) > 1:
            hit("Multiple network namespaces", f"{len(namespaces)} found — sibling containers may exist")
            for ns in sorted(namespaces):
                dim(f"    {ns}")
        else:
            dim("    Only one network namespace visible")

        # ── Internal subnet discovery ────────────────────────────────
        print(f"\n  {C.BOLD}Internal subnets / container networks:{C.RESET}")
        routes = run("ip route 2>/dev/null")
        for line in routes.splitlines():
            # Flag non-standard RFC1918 ranges that look like container networks
            if any(x in line for x in ["172.16.", "172.17.", "172.18.", "172.19.",
                                        "172.2", "10.0.", "10.1.", "192.168."]):
                hit("Internal route", line.strip())
            else:
                dim(f"    {line}")

        # ── /etc/hosts — internal hostnames ─────────────────────────
        print(f"\n  {C.BOLD}/etc/hosts — internal container hostnames:{C.RESET}")
        hosts = run("grep -v '^#\\|^$\\|127.0.0.1\\|::1' /etc/hosts 2>/dev/null")
        if hosts:
            for line in hosts.splitlines():
                hit("Host entry", line.strip())
        else:
            dim("    No custom entries found")

    elif IS_WINDOWS:
        print(f"\n  {C.BOLD}Running containers (Windows):{C.RESET}")
        dim(run("docker ps 2>nul"))




# ═════════════════════════════════════════════
#  MODULE 14 — Config & Code Analysis
# ═════════════════════════════════════════════
def enum_configs():
    section("CONFIG & CODE ANALYSIS")

    # ── Locations to scan ───────────────────────────────────────────
    SCAN_ROOTS = [
        "/var/www", "/opt", "/srv", "/app", "/api",
        "/backend", "/home", "/etc", "/usr/local",
    ]

    # ── File extensions to collect ──────────────────────────────────
    CONFIG_EXTS = {
        ".ini", ".conf", ".cfg", ".env", ".xml",
        ".yaml", ".yml", ".toml", ".properties",
    }
    CODE_EXTS = {
        ".php", ".py", ".rb", ".js", ".sh",
        ".pl", ".go", ".java", ".ts",
    }
    ALL_EXTS = CONFIG_EXTS | CODE_EXTS

    # ── High-value filenames regardless of extension ─────────────────
    INTERESTING_NAMES = {
        "database.yml", "database.php", "db.php", "db.py",
        "settings.py", "settings.php", "config.php", "config.py",
        "config.rb", "config.js", "configuration.php",
        "application.yml", "application.properties",
        "wp-config.php", ".env", "secrets.yml",
        "docker-compose.yml", "supervisord.conf",
    }

    # ── Dangerous patterns per language ─────────────────────────────
    # Each entry: (regex_pattern, description, severity)
    # severity: 'crit' = red, 'warn' = yellow, 'info' = cyan
    PATTERNS = [
        # ── Shell execution ──────────────────────────────────────────
        (r"exec\s*\(.*\$",                          "exec() with variable input",              "crit"),
        (r"system\s*\(.*\$",                        "system() with variable input",            "crit"),
        (r"shell_exec\s*\(.*\$",                    "shell_exec() with variable input",        "crit"),
        (r"passthru\s*\(.*\$",                      "passthru() with variable input",          "crit"),
        (r"popen\s*\(.*\$",                         "popen() with variable input",             "crit"),
        (r"proc_open\s*\(.*\$",                     "proc_open() with variable input",         "crit"),
        (r"os\.system\s*\(",                        "os.system() call",                        "crit"),
        (r"os\.popen\s*\(",                         "os.popen() call",                         "crit"),
        (r"subprocess\.(call|run|Popen)\s*\(.*shell\s*=\s*True", "subprocess with shell=True","crit"),
        (r"`.*\$.*`",                               "Backtick shell execution with variable",   "crit"),
        (r"eval\s*\(.*\$",                          "eval() with variable input",              "crit"),
        (r"eval\s*\(.*request",                     "eval() with request input",               "crit"),
        (r"assert\s*\(.*\$_(GET|POST|REQUEST)",     "assert() with user input (PHP RCE)",      "crit"),

        # ── SQL injection ────────────────────────────────────────────
        (r"[\"']SELECT.*\+.*[\"']",                 "SQL string concatenation",                "crit"),
        (r"[\"']INSERT.*\+.*[\"']",                 "SQL INSERT concatenation",                "crit"),
        (r"[\"']UPDATE.*\+.*[\"']",                 "SQL UPDATE concatenation",                "crit"),
        (r"[\"']DELETE.*\+.*[\"']",                 "SQL DELETE concatenation",                "crit"),
        (r"f[\"'].*SELECT.*\{",                     "SQL f-string injection (Python)",         "crit"),
        (r"sprintf.*SELECT.*\$",                    "SQL sprintf injection",                   "crit"),
        (r"mysql_query\s*\(\s*[\"'].*\$",           "Unsanitized mysql_query()",               "crit"),
        (r"\$_(GET|POST|REQUEST|COOKIE)\[.*\].*SELECT", "User input direct to SQL",           "crit"),

        # ── File inclusion / path traversal ─────────────────────────
        (r"include\s*\(\s*\$_(GET|POST|REQUEST)",   "include() with user input (LFI/RFI)",    "crit"),
        (r"require\s*\(\s*\$_(GET|POST|REQUEST)",   "require() with user input (LFI/RFI)",    "crit"),
        (r"include_once\s*\(\s*\$_(GET|POST)",      "include_once() with user input",          "crit"),
        (r"open\s*\(.*request\.",                   "File open with request input",            "crit"),
        (r"open\s*\(.*\+.*\)",                      "File open with concatenated path",        "warn"),
        (r"readfile\s*\(\s*\$_(GET|POST)",          "readfile() with user input",              "crit"),

        # ── Deserialization ──────────────────────────────────────────
        (r"unserialize\s*\(\s*\$_(GET|POST|REQUEST|COOKIE)", "unserialize() user input",      "crit"),
        (r"pickle\.loads\s*\(",                     "pickle.loads() — deserialization RCE",    "crit"),
        (r"yaml\.load\s*\([^,)]*\)",                "yaml.load() without Loader= (unsafe)",   "warn"),
        (r"Marshal\.load\s*\(",                     "Ruby Marshal.load() — deserialization",   "crit"),
        (r"ObjectInputStream",                      "Java ObjectInputStream deserialization",  "warn"),

        # ── Template injection ───────────────────────────────────────
        (r"render_template_string\s*\(",            "Flask render_template_string() — SSTI",   "crit"),
        (r"Environment\(.*loader.*\).*from_string", "Jinja2 from_string() — SSTI risk",       "warn"),
        (r"ERB\.new\s*\(.*\$",                      "Ruby ERB with variable — SSTI",           "crit"),
        (r"Twig.*createTemplate\s*\(",              "Twig createTemplate() — SSTI",            "crit"),

        # ── XXE / XML ────────────────────────────────────────────────
        (r"simplexml_load_string\s*\(",             "simplexml_load_string() — XXE risk",      "warn"),
        (r"DOMDocument.*loadXML\s*\(",              "DOMDocument loadXML() — XXE risk",        "warn"),
        (r"etree\.parse\s*\(",                      "lxml etree.parse() — XXE if not hardened","warn"),
        (r"resolve_entities\s*=\s*True",            "XML entity resolution enabled",           "warn"),

        # ── SSRF ─────────────────────────────────────────────────────
        (r"(curl_exec|file_get_contents|requests\.get)\s*\(.*\$_(GET|POST|REQUEST)", "SSRF — user-controlled URL", "crit"),
        (r"requests\.(get|post)\s*\(.*request\.",   "SSRF — user-controlled URL (Python)",    "crit"),
        (r"urllib.*urlopen\s*\(.*request\.",        "SSRF — urllib with request input",        "crit"),

        # ── Hardcoded secrets in code ─────────────────────────────────
        (r"(password|passwd|secret|api_key|apikey|token)\s*=\s*['\"][^'\"]{6,}['\"]",
                                                    "Hardcoded credential in code",            "warn"),
        (r"(AWS_SECRET|AWS_KEY|PRIVATE_KEY)\s*=\s*['\"][^'\"]+['\"]",
                                                    "Hardcoded cloud/crypto key",              "crit"),

        # ── Weak crypto / random ─────────────────────────────────────
        (r"md5\s*\(",                               "MD5 usage — weak hashing",                "info"),
        (r"sha1\s*\(",                              "SHA1 usage — weak hashing",               "info"),
        (r"random\.(random|randint|choice)\s*\(",  "Non-crypto random — predictable",          "info"),
        (r"Math\.random\s*\(",                      "JS Math.random() — non-crypto",           "info"),
    ]

    # ── Limits to keep scan fast ─────────────────────────────────────
    MAX_FILES     = 500    # stop collecting after this many files
    MAX_FILE_SIZE = 512000 # skip files over 500KB
    MAX_DEPTH     = 6      # max directory depth from each root

    # ── Collect files ────────────────────────────────────────────────
    print(f"\n  {C.BOLD}Scanning locations:{C.RESET}")
    collected = []
    for root in SCAN_ROOTS:
        if not os.path.isdir(root):
            continue
        if len(collected) >= MAX_FILES:
            break
        info("Scanning", root)
        try:
            root_depth = root.rstrip("/").count("/")
            for dirpath, dirnames, filenames in os.walk(root):
                # Enforce depth limit
                current_depth = dirpath.rstrip("/").count("/") - root_depth
                if current_depth >= MAX_DEPTH:
                    dirnames.clear()
                    continue
                # Skip noise directories
                dirnames[:] = [d for d in dirnames if d not in {
                    ".git", "node_modules", "__pycache__", ".svn",
                    "vendor", "cache", "tmp", "log", "logs",
                    "test", "tests", "spec", "migrations",
                }]
                for fname in filenames:
                    if len(collected) >= MAX_FILES:
                        break
                    fpath = os.path.join(dirpath, fname)
                    ext   = os.path.splitext(fname)[1].lower()
                    if ext in ALL_EXTS or fname.lower() in INTERESTING_NAMES:
                        try:
                            if os.access(fpath, os.R_OK) and os.path.getsize(fpath) <= MAX_FILE_SIZE:
                                collected.append(fpath)
                        except OSError:
                            pass
        except PermissionError:
            pass

    info("Files collected", str(len(collected)))

    if not collected:
        dim("    No readable config/code files found")
        return

    # ── Interesting filenames — show first ──────────────────────────
    print(f"\n  {C.BOLD}High-value config files found:{C.RESET}")
    named_hits = [f for f in collected if os.path.basename(f).lower() in INTERESTING_NAMES]
    if named_hits:
        for f in named_hits:
            hit("Config", f)
    else:
        dim("    None of the known high-value filenames found")

    # ── Pattern scan ────────────────────────────────────────────────
    print(f"\n  {C.BOLD}Scanning for dangerous patterns:{C.RESET}")

    SEV_COLOR = {
        "crit": C.RED,
        "warn": C.YELLOW,
        "info": C.CYAN,
    }
    SEV_LABEL = {
        "crit": "CRITICAL",
        "warn": "WARNING ",
        "info": "INFO    ",
    }

    total_findings = 0

    for fpath in collected:
        file_findings = []
        try:
            with open(fpath, "r", encoding="utf-8", errors="ignore") as fh:
                lines = fh.readlines()

            for lineno, line in enumerate(lines, start=1):
                stripped = line.rstrip()
                for pattern, desc, sev in PATTERNS:
                    if re.search(pattern, stripped, re.IGNORECASE):
                        # Grab context: 2 lines before and after
                        ctx_start = max(0, lineno - 3)
                        ctx_end   = min(len(lines), lineno + 2)
                        context   = lines[ctx_start:ctx_end]
                        file_findings.append((lineno, stripped, desc, sev, ctx_start + 1, context))
                        break  # one match per line is enough

        except Exception:
            continue

        if file_findings:
            total_findings += len(file_findings)
            print(f"\n  {C.BOLD}{C.WHITE}┌─ {fpath}{C.RESET}")

            for lineno, line, desc, sev, ctx_lineno, context in file_findings:
                col = SEV_COLOR[sev]
                lbl = SEV_LABEL[sev]
                print(f"  {col}│  [{lbl}] line {lineno} — {desc}{C.RESET}")

                # Print context with the hit line highlighted
                for i, ctx_line in enumerate(context):
                    actual_lineno = ctx_lineno + i
                    ctx_stripped  = ctx_line.rstrip()
                    if actual_lineno == lineno:
                        # Highlighted hit line
                        print(f"  {col}│  {C.BOLD}  {actual_lineno:>4} ▶  {ctx_stripped}{C.RESET}")
                    else:
                        print(f"  {C.GREY}│       {actual_lineno:>4}    {ctx_stripped}{C.RESET}")
                print(f"  {col}│{C.RESET}")

            print(f"  {C.BOLD}{C.WHITE}└{'─' * 58}{C.RESET}")

    if total_findings == 0:
        dim("    No dangerous patterns found in scanned files")
    else:
        print(f"\n  {C.YELLOW}[+]{C.RESET} {C.BOLD}Total findings: {total_findings}{C.RESET}")

    if IS_WINDOWS:
        dim("    Config/code analysis not implemented for Windows")


