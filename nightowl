def parse_args():
    p = argparse.ArgumentParser(
        description="HTB/CTF Post-Exploitation Enumerator",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        add_help=False   # we handle --help ourselves
    )
    p.add_argument("--help",        action="store_true", help="Show help menu")
    p.add_argument("--all",         action="store_true", help="Run all checks")
    p.add_argument("--system",      action="store_true", help="System info")
    p.add_argument("--users",       action="store_true", help="User enumeration")
    p.add_argument("--groups",      action="store_true", help="Group enumeration")
    p.add_argument("--sudo",        action="store_true", help="Sudo/SUID/capabilities")
    p.add_argument("--binaries",    action="store_true", help="Interesting binaries")
    p.add_argument("--jobs",        action="store_true", help="Cron/scheduled jobs")
    p.add_argument("--writable",    action="store_true", help="Writable files/dirs")
    p.add_argument("--services",    action="store_true", help="Services & local ports")
    p.add_argument("--creds",       action="store_true", help="Credential hunting")
    p.add_argument("--network",     action="store_true", help="Network info")
    p.add_argument("--software",    action="store_true", help="Installed software")
    p.add_argument("--env",         action="store_true", help="Environment variables")
    p.add_argument("--container",   action="store_true", help="Container escape checks")
    p.add_argument("--configs",     action="store_true", help="Config & code analysis for injection points")
    p.add_argument("--no-color",    action="store_true", help="Disable color output")
    p.add_argument("--output",      action="store_true", help="Save to timestamped file")
    return p.parse_args()


class Tee:
    """Write to both stdout and a file, stripping ANSI codes for the file."""
    ANSI_ESCAPE = re.compile(r'\x1b\[[0-9;]*m')

    def __init__(self, filepath):
        self.terminal = sys.stdout
        self.logfile  = open(filepath, "w", encoding="utf-8")

    def write(self, message):
        self.terminal.write(message)
        self.logfile.write(self.ANSI_ESCAPE.sub("", message))

    def flush(self):
        self.terminal.flush()
        self.logfile.flush()

    def close(self):
        self.logfile.close()


def main():
    args = parse_args()

    # --help: show custom menu and exit
    if args.help:
        print_help()
        sys.exit(0)

    # --output: tee stdout to a timestamped file, strip colors in file
    log_path = None
    tee = None
    if args.output:
        hostname = socket.gethostname()
        timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
        log_path = f"nightowl_{hostname}_{timestamp}.txt"
        tee = Tee(log_path)
        sys.stdout = tee

    if args.no_color:
        for attr in dir(C):
            if not attr.startswith("_"):
                setattr(C, attr, "")

    banner()
    print(f"  {C.GREY}Started: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}  |  "
          f"Platform: {platform.system()}  |  "
          f"User: {run('whoami')}{C.RESET}")

    if log_path:
        print(f"  {C.GREEN}[*]{C.RESET} Saving output to: {C.BOLD}{log_path}{C.RESET}")

    # Build module map
    MODULE_MAP = {
        "system":    ("System Info",           enum_system),
        "users":     ("User Enumeration",      enum_users),
        "groups":    ("Group Enumeration",     enum_groups),
        "sudo":      ("Sudo/SUID/Caps",        enum_sudo),
        "binaries":  ("Interesting Binaries",  enum_interesting_binaries),
        "jobs":      ("Scheduled Jobs",        enum_jobs),
        "writable":  ("Writable Paths",        enum_writable),
        "services":  ("Services & Ports",      enum_services),
        "creds":     ("Credential Hunting",    enum_credentials),
        "network":   ("Network Info",          enum_network),
        "software":  ("Installed Software",    enum_software),
        "env":       ("Environment",           enum_environment),
        "container": ("Container Discovery & Pivoting", enum_container),
        "configs":   ("Config & Code Analysis",         enum_configs),
    }

    if args.all or not any([
        args.system, args.users, args.groups, args.sudo, args.binaries,
        args.jobs, args.writable, args.services, args.creds,
        args.network, args.software, args.env, args.container, args.configs,
    ]):
        # Default: run all
        to_run = list(MODULE_MAP.keys())
    else:
        to_run = [k for k in MODULE_MAP if getattr(args, k, False)]

    checks_run = []
    for key in to_run:
        label, fn = MODULE_MAP[key]
        try:
            fn()
            checks_run.append(label)
        except KeyboardInterrupt:
            print(f"\n{C.YELLOW}  [!] Interrupted by user — skipping remaining checks{C.RESET}")
            break
        except Exception as e:
            warn(f"Module '{label}' error: {e}")

    print_summary(checks_run)

    if tee:
        sys.stdout = tee.terminal
        tee.close()
        print(f"\n  {C.GREEN}[*]{C.RESET} Report saved → {C.BOLD}{log_path}{C.RESET}\n")


if __name__ == "__main__":
    main()
